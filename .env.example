# Public site URL used for canonical URLs, sitemap, robots.txt and JSON-LD.
# The code falls back to https://allyonopatti.com when unset — confirm the
# real production domain before launch.
NEXT_PUBLIC_SITE_URL=https://allyonopatti.com

# Email address shown on the contact and policy pages.
NEXT_PUBLIC_CONTACT_EMAIL=contact@allyonopatti.com

# Server-side delivery endpoint for contact-form submissions (e.g. a form
# relay service webhook). When unset, the form validates input but tells the
# user to email directly instead of pretending to send.
CONTACT_FORM_ENDPOINT=

# Google Analytics (GA4) measurement ID. Falls back to the ID supplied
# 2026-07-18 if unset — set this explicitly to switch properties.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DY32HFLYDN
